{
  // 麻薯 team site: Cloudflare Access (email code) in front, invite-code membership,
  // margin comments in D1. The deploy workflow fills database_id and the vars below.
  "name": "mashu",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "mashu", "database_id": "REPLACED_AT_DEPLOY", "migrations_dir": "migrations" }
  ],
  "vars": {
    "TEAM_DOMAIN": "REPLACED_AT_DEPLOY",
    "ACCESS_AUD": "REPLACED_AT_DEPLOY",
    "ADMIN_EMAILS": "REPLACED_AT_DEPLOY"
  },
  "observability": { "enabled": true }
}
